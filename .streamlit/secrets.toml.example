# Streamlit secrets — 本機金鑰，勿提交到 git
# 複製成 secrets.toml 後填入；上線請改在 Streamlit Cloud 的 Secrets 設定。

FINMIND_TOKEN = ""
GEMINI_API_KEY = ""
# 後端登入（Streamlit Cloud 請填已上線的 API 網址，不要填 127.0.0.1）
# 本機註冊的帳號不會出現在 Render；另一台裝置請用同一個雲端網址，並用「註冊」或同一個後端帳號。
API_BASE_URL = "https://twmc-backend.onrender.com"
# 沒接後端時，雲端仍可用共用密碼
APP_PASSWORD = ""
